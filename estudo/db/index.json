{"text": "<style>\n/* Layout: cabeçalho com conclusão + números-chave; seção 1º turno (completo) e seção 2º turno (parcial, em coleta) em grades de cartões */\n.el-wrap { max-width: 1180px; margin-inline: auto; display: flex; flex-direction: column; gap: var(--cds-gap-xl); font-family: var(--font-anthropic-sans); }\n.el-head { display: flex; flex-direction: column; gap: var(--cds-gap-sm); }\n.el-title { font-family: var(--font-anthropic-serif); font-weight: 400; font-size: var(--cds-font-size-title); margin: 0; text-wrap: balance; }\n.el-lede { color: var(--color-fg-muted); font-size: var(--cds-font-size-body); margin: 0; max-width: 72ch; line-height: 1.5; }\n.el-lede b, .el-note b, .el-prog b { font-weight: 600; }\n.el-tiles { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 10.5rem), 1fr)); gap: var(--cds-gap-md); }\n.el-tile { background: var(--color-panel); border: 1px solid var(--color-border-line); border-radius: var(--cds-radius); padding: var(--cds-pad-md) var(--cds-pad-lg); display: flex; flex-direction: column; gap: var(--cds-gap-xs); }\n.el-tile .k { font-size: var(--cds-font-size-caption); color: var(--color-fg-muted); }\n.el-tile .v { font-family: var(--font-anthropic-serif); font-weight: 400; font-size: var(--cds-font-size-title); font-variant-numeric: tabular-nums; }\n.el-tile .s { font-size: var(--cds-font-size-caption); color: var(--color-fg-muted); font-variant-numeric: tabular-nums; }\n.el-sec { display: flex; flex-direction: column; gap: var(--cds-gap-md); }\n.el-sec > h2 { font-size: var(--cds-font-size-heading); font-weight: var(--cds-font-weight-medium); margin: 0; display: flex; align-items: center; gap: var(--cds-gap-sm); flex-wrap: wrap; }\n.el-pill { font-size: var(--cds-font-size-caption); font-weight: 400; padding: 2px 8px; border-radius: 999px; border: 1px solid var(--color-border-line); color: var(--color-fg-muted); }\n.el-pill.warn { color: var(--color-warn); border-color: currentColor; }\n.el-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 26rem), 1fr)); gap: var(--cds-gap-md); }\n.el-card { background: var(--color-panel); border: 1px solid var(--color-border-line); border-radius: var(--cds-radius); padding: var(--cds-pad-lg); display: flex; flex-direction: column; gap: var(--cds-gap-sm); min-width: 0; }\n.el-card.wide { grid-column: 1 / -1; }\n.el-card h3 { font-size: var(--cds-font-size-heading); font-weight: var(--cds-font-weight-medium); margin: 0; }\n.el-note { font-size: var(--cds-font-size-caption); color: var(--color-fg-muted); margin: 0; line-height: 1.45; }\n.el-chart { position: relative; min-height: 220px; }\n.el-chart svg { display: block; overflow: visible; }\n.el-chart text { fill: var(--color-fg-muted); font-size: 11px; font-family: var(--font-anthropic-sans); }\n.el-chart .lbl { fill: var(--color-fg); }\n.el-tip { position: absolute; pointer-events: none; background: var(--cds-surface-popover); border: 1px solid var(--cds-border); border-radius: var(--cds-radius); box-shadow: var(--cds-shadow-popover); padding: var(--cds-pad-xs) var(--cds-pad-sm); font-size: var(--cds-font-size-caption); white-space: nowrap; z-index: 2; }\n.el-tip .h { color: var(--cds-text-secondary); }\n.el-tbl-box { overflow: auto; max-height: 26rem; }\n.el-tbl { width: 100%; border-collapse: collapse; font-size: var(--cds-font-size-caption); font-variant-numeric: tabular-nums; }\n.el-tbl th, .el-tbl td { padding: 6px 8px; text-align: right; border-bottom: 1px solid var(--color-border-line); white-space: nowrap; }\n.el-tbl th:first-child, .el-tbl td:first-child { text-align: left; }\n.el-tbl th { position: sticky; top: 0; background: var(--color-panel); color: var(--color-fg-muted); font-weight: 500; }\n.el-pos { color: var(--color-ok); } .el-neg { color: var(--color-bad); }\n.el-ctrl { display: flex; gap: var(--cds-gap-sm); align-items: center; flex-wrap: wrap; font-size: var(--cds-font-size-caption); color: var(--color-fg-muted); }\n.el-ctrl select { font: inherit; color: var(--color-fg); background: var(--color-bg); border: 1px solid var(--color-border-line); border-radius: var(--cds-radius); padding: 4px 8px; }\n.el-ctrl select:focus-visible { outline: 2px solid var(--color-fg); outline-offset: 1px; }\n.el-bar { height: 10px; border-radius: 999px; background: var(--cds-chart-grid); overflow: hidden; }\n.el-bar > i { display: block; height: 100%; background: var(--color-warn); border-radius: 999px; }\n.el-prog { display: flex; flex-direction: column; gap: var(--cds-gap-xs); font-size: var(--cds-font-size-body); }\n.el-legend { display: flex; gap: var(--cds-gap-md); flex-wrap: wrap; font-size: var(--cds-font-size-caption); color: var(--color-fg-muted); }\n.el-legend span { display: inline-flex; align-items: center; gap: 6px; }\n.el-legend i { width: 10px; height: 10px; border-radius: 2px; display: inline-block; }\n[data-dash-source-state=empty] { color: transparent; }\n[data-dash-source-state=refreshing] { opacity: .5; transition: opacity var(--cds-dur-slow); }\n.el-fail { display: flex; align-items: center; justify-content: center; gap: 8px; min-height: inherit; height: 100%; color: var(--color-fg-muted); font-size: var(--cds-font-size-caption); }\n.el-fail::before { content: \"\"; width: .375rem; height: .375rem; border-radius: 50%; background: var(--color-bad); }\n</style>\n\n<div class=\"el-wrap\">\n  <header class=\"el-head\">\n    <h1 class=\"el-title\" id=\"topo\">Eleição presidencial 2026, seção por seção</h1>\n    <p class=\"el-lede\" id=\"lede\"><span class=\"dash-skeleton\">—</span></p>\n  </header>\n\n  <div class=\"el-tiles\" data-fetchpriority=\"high\">\n    <div class=\"el-tile\"><span class=\"k\">Lula (13) · 2º turno</span><span class=\"v dash-skeleton\" data-source=\"t2_candidatos\" data-field=\"pct_validos\" data-where=\"numero=13\" data-fmt=\"pct2\">—</span><span class=\"s\">1º turno: <span data-source=\"t1_candidatos\" data-field=\"pct_validos\" data-where=\"numero=13\" data-fmt=\"pct2\">—</span></span></div>\n    <div class=\"el-tile\"><span class=\"k\">Flávio Bolsonaro (22) · 2º turno</span><span class=\"v dash-skeleton\" data-source=\"t2_candidatos\" data-field=\"pct_validos\" data-where=\"numero=22\" data-fmt=\"pct2\">—</span><span class=\"s\">1º turno: <span data-source=\"t1_candidatos\" data-field=\"pct_validos\" data-where=\"numero=22\" data-fmt=\"pct2\">—</span></span></div>\n    <div class=\"el-tile\"><span class=\"k\">Vantagem de Lula no 2º turno</span><span class=\"v dash-skeleton\" data-source=\"t2_nacional\" data-field=\"dif_13_22\" data-row=\"0\" data-fmt=\"compact\">—</span><span class=\"s\">votos · no 1º turno o 22 liderava por <span data-source=\"t1_nacional\" data-field=\"dif_22_13\" data-row=\"0\" data-fmt=\"compact\">—</span></span></div>\n    <div class=\"el-tile\"><span class=\"k\">Abstenção · 2º turno</span><span class=\"v dash-skeleton\" data-source=\"t2_nacional\" data-field=\"abstencao_pct\" data-row=\"0\" data-fmt=\"pct1\">—</span><span class=\"s\">1º turno: <span data-source=\"t1_nacional\" data-field=\"abstencao_pct\" data-row=\"0\" data-fmt=\"pct1\">—</span> · <span data-source=\"t1_nacional\" data-field=\"aptos\" data-row=\"0\" data-fmt=\"compact\">—</span> aptos</span></div>\n    <div class=\"el-tile\"><span class=\"k\">Seções analisadas</span><span class=\"v dash-skeleton\" data-source=\"t1_nacional\" data-field=\"secoes\" data-row=\"0\" data-fmt=\"int\">—</span><span class=\"s\">em <span data-source=\"t1_nacional\" data-field=\"municipios\" data-row=\"0\" data-fmt=\"int\">—</span> municípios + exterior</span></div>\n  </div>\n\n  <section class=\"el-sec\" id=\"primeiro-turno\">\n    <h2>1º turno · 4 de outubro <span class=\"el-pill\">completo</span></h2>\n    <div class=\"el-grid\">\n      <div class=\"el-card\">\n        <h3 id=\"candidatos\">Votos válidos por candidato</h3>\n        <p class=\"el-note\">Percentual dos votos válidos (exclui brancos e nulos). Os três seguintes somam o que se chama aqui de terceira via.</p>\n        <div class=\"el-chart dash-skeleton\" id=\"ch-cand\" data-source=\"t1_candidatos\" style=\"min-height:330px\"></div>\n      </div>\n      <div class=\"el-card\">\n        <h3 id=\"por-uf\">Quem venceu cada UF no confronto 13 × 22</h3>\n        <p class=\"el-note\">Barra a partir de 50%: à direita, vantagem de Lula; à esquerda, de Flávio. Considera só os votos dos dois. ZZ é o exterior.</p>\n        <div class=\"el-chart dash-skeleton\" id=\"ch-uf\" data-source=\"t1_uf\" style=\"min-height:560px\"></div>\n      </div>\n      <div class=\"el-card\">\n        <h3 id=\"distribuicao\">Distribuição das seções pelo voto em Lula</h3>\n        <p class=\"el-note\">Número de seções por faixa de 2 p.p. da fatia de Lula nos votos 13+22 (seções com ao menos 30 votos nos dois). Duas corcovas indicam um país geograficamente polarizado.</p>\n        <div class=\"el-chart dash-skeleton\" id=\"ch-hist\" data-source=\"t1_hist_secao\" style=\"min-height:260px\"></div>\n      </div>\n      <div class=\"el-card\">\n        <h3 id=\"abstencao\">Abstenção da seção e voto</h3>\n        <p class=\"el-note\">Seções divididas em dez grupos iguais pela abstenção. Eixo vertical: fatia de Lula nos votos 13+22 dentro de cada grupo.</p>\n        <div class=\"el-chart dash-skeleton\" id=\"ch-abst\" data-source=\"t1_abstencao_decil\" style=\"min-height:260px\"></div>\n      </div>\n      <div class=\"el-card\">\n        <h3 id=\"urnas\">Modelo de urna não muda o resultado</h3>\n        <p class=\"el-note\">A diferença bruta entre modelos reflete onde cada modelo foi instalado. Comparando seções do mesmo município, o desvio some (fica abaixo de 0,4 p.p.).</p>\n        <div class=\"el-tbl-box\">\n          <table class=\"el-tbl dash-skeleton\" id=\"tb-urna\" data-source=\"t1_modelo_urna\" data-row-key=\"modelo\">\n            <thead><tr><th data-field=\"modelo\">Modelo</th><th data-field=\"secoes\">Seções</th><th data-field=\"pct_13_bruto\">Lula no par 13×22 (bruto)</th><th data-field=\"desvio_mesmo_municipio_pp\">Desvio no mesmo município</th></tr></thead>\n            <tbody></tbody>\n          </table>\n        </div>\n      </div>\n      <div class=\"el-card\">\n        <h3 id=\"redutos\">Redutos de cada candidato</h3>\n        <p class=\"el-note\">Municípios com maior percentual de votos válidos no candidato (mínimo de 5 mil eleitores aptos).</p>\n        <div class=\"el-ctrl\"><label for=\"sel-cand\">Candidato</label><select id=\"sel-cand\"></select></div>\n        <div class=\"el-tbl-box\">\n          <table class=\"el-tbl dash-skeleton\" id=\"tb-red\" data-source=\"t1_redutos\" data-row-key=\"chave\">\n            <thead><tr><th data-field=\"municipio\">Município</th><th data-field=\"aptos\">Aptos</th><th data-field=\"pct_validos\">% válidos</th></tr></thead>\n            <tbody></tbody>\n          </table>\n        </div>\n      </div>\n      <div class=\"el-card wide\">\n        <h3 id=\"tabela-uf\">Resultado por UF</h3>\n        <p class=\"el-note\">Percentuais sobre votos válidos. Terceira via = Cury + Renan + Caiado.</p>\n        <div class=\"el-tbl-box\">\n          <table class=\"el-tbl dash-skeleton\" id=\"tb-uf\" data-source=\"t1_uf\" data-row-key=\"uf\">\n            <thead><tr><th data-field=\"uf\">UF</th><th data-field=\"regiao\">Região</th><th data-field=\"aptos\">Aptos</th><th data-field=\"abstencao_pct\">Abstenção</th><th data-field=\"pct_22\">Flávio (22)</th><th data-field=\"pct_13\">Lula (13)</th><th data-field=\"pct_terceira_via\">Terceira via</th><th data-field=\"pct_13_no_par\">Lula no par 13×22</th></tr></thead>\n            <tbody></tbody>\n          </table>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  <section class=\"el-sec\" id=\"segundo-turno\">\n    <h2>2º turno · 25 de outubro <span class=\"el-pill\">completo</span></h2>\n    <div class=\"el-card wide\">\n      <div class=\"el-prog\">\n        <div><b data-source=\"t2_progresso\" data-field=\"secoes_coletadas\" data-row=\"0\" data-fmt=\"int\">—</b> seções pareadas entre os dois turnos, em <span data-source=\"t2_progresso\" data-field=\"ufs\" data-row=\"0\">—</span> UFs (incluindo o exterior) · fonte: <span data-source=\"t2_progresso\" data-field=\"atualizado\" data-row=\"0\">—</span></div>\n        <p class=\"el-note\">Os dois turnos vêm dos arquivos oficiais de votação por seção do TSE. Antes da publicação, 231 mil seções foram lidas dos boletins de urna do portal de resultados; todas coincidiram voto a voto com o arquivo oficial.</p>\n      </div>\n    </div>\n    <div class=\"el-grid\">\n      <div class=\"el-card\">\n        <h3 id=\"t2-uf\">Mesmas seções, 1º × 2º turno</h3>\n        <p class=\"el-note\">Fatia de Lula nos votos 13+22 em cada turno, somando as mesmas seções. Swing positivo = Lula cresceu. ZZ é o exterior.</p>\n        <div class=\"el-tbl-box\">\n          <table class=\"el-tbl dash-skeleton\" id=\"tb-t2\" data-source=\"t2_uf_parcial\" data-row-key=\"uf\">\n            <thead><tr><th data-field=\"uf\">UF</th><th data-field=\"secoes\">Seções</th><th data-field=\"pct_13_t1\">Lula 1º t.</th><th data-field=\"pct_13_t2\">Lula 2º t.</th><th data-field=\"swing_pp\">Swing (p.p.)</th><th data-field=\"abst_t1\">Abst. 1º t.</th><th data-field=\"abst_t2\">Abst. 2º t.</th></tr></thead>\n            <tbody></tbody>\n          </table>\n        </div>\n      </div>\n      <div class=\"el-card\">\n        <h3 id=\"t2-dispersao\">Cada ponto é uma seção</h3>\n        <p class=\"el-note\">Fatia de Lula no 1º turno (horizontal) e no 2º (vertical), amostra aleatória de 3 mil seções do país. Acima da diagonal, Lula cresceu.</p>\n        <div class=\"el-legend\" id=\"lg-sc\"></div>\n        <div class=\"el-chart dash-skeleton\" id=\"ch-sc\" data-source=\"t2_dispersao\" style=\"min-height:320px\"></div>\n      </div>\n      <div class=\"el-card wide\">\n        <h3 id=\"transferencia\">Para onde foram os votos do 1º turno (estimativa)</h3>\n        <p class=\"el-note\">Regressão ecológica seção a seção (mínimos quadrados não negativos): cada linha mostra como os eleitores de uma opção do 1º turno se distribuíram no 2º. É inferência a partir de agregados, não pesquisa com eleitores; trate como indicação. Usa <span data-source=\"t2_progresso\" data-field=\"secoes_transferencia\" data-row=\"0\" data-fmt=\"int\">—</span> seções.</p>\n        <div class=\"el-chart dash-skeleton\" id=\"ch-tr\" data-source=\"t2_transferencia\" style=\"min-height:300px\"></div>\n      </div>\n    </div>\n  </section>\n</div>\n\n<script>\n(() => {\n  const F = {\n    pct1: d3.format('.1%'), pct2: d3.format('.2%'), int: d3.format(',d'),\n    compact: v => new Intl.NumberFormat('pt-BR', {notation: 'compact', maximumFractionDigits: 1}).format(v),\n  };\n  const ptLocale = d3.formatLocale({decimal: ',', thousands: '.', grouping: [3], currency: ['R$', '']});\n  F.pct1 = ptLocale.format('.1%'); F.pct2 = ptLocale.format('.2%'); F.int = ptLocale.format(',d');\n  const pp = ptLocale.format('+.2f');\n  const C13 = () => '#d93636', C22 = () => '#2f6fdb'; // Lula vermelho, Flávio azul\n  const muted = 'var(--cds-chart-muted)';\n\n  function fail(el) { el.classList.remove('dash-skeleton'); el.innerHTML = ''; const d = document.createElement('div'); d.className = 'el-fail'; d.textContent = 'Failed to load'; el.appendChild(d); }\n  function ready(id, el) {\n    const r = dash.data(id);\n    if (r.status === 'ok') { el.classList.remove('dash-skeleton'); return r.data; }\n    if (r.status === 'error' || r.status === 'connect' || r.status === 'declined' || r.status === 'missing') fail(el);\n    else { el.innerHTML = ''; el.classList.add('dash-skeleton'); }\n    return null;\n  }\n  function measure(svg, texts) {\n    const t = svg.append('text').attr('class', 'lbl');\n    let m = 0; texts.forEach(s => { t.text(s); m = Math.max(m, t.node().getComputedTextLength()); });\n    t.remove(); return m;\n  }\n  function tip(box) {\n    let el = box.querySelector('.el-tip');\n    if (!el) { el = document.createElement('div'); el.className = 'el-tip'; el.hidden = true; box.appendChild(el); }\n    return {\n      show(ev, head, lines) {\n        el.textContent = '';\n        const h = document.createElement('div'); h.className = 'h'; h.textContent = head; el.appendChild(h);\n        lines.forEach(l => { const d = document.createElement('div'); d.textContent = l; el.appendChild(d); });\n        el.hidden = false;\n        const [x, y] = d3.pointer(ev, box), w = el.offsetWidth;\n        el.style.left = Math.max(0, Math.min(box.clientWidth - w, x + 12)) + 'px';\n        el.style.top = (y + 14) + 'px';\n      },\n      hide() { el.hidden = true; }\n    };\n  }\n  function cleanAxis(g) { g.attr('font-size', null).attr('font-family', null); g.select('.domain').attr('stroke', 'var(--cds-chart-axis)'); g.selectAll('.tick line').attr('stroke', 'var(--cds-chart-grid)'); }\n\n  // ---------- marcas simples (tiles e textos)\n  function fillMarks() {\n    document.querySelectorAll('[data-source][data-field]').forEach(el => {\n      if (el.tagName === 'TH') return;\n      const r = dash.data(el.dataset.source);\n      if (r.status !== 'ok') { if (r.status === 'error') el.classList.remove('dash-skeleton'); return; }\n      let row;\n      if (el.dataset.where) { const [k, v] = el.dataset.where.split('='); row = r.data.find(x => String(x[k]) === v); }\n      else row = r.data[+el.dataset.row || 0];\n      if (!row) return;\n      const v = row[el.dataset.field], f = F[el.dataset.fmt];\n      el.textContent = f ? f(+v) : v;\n      el.classList.remove('dash-skeleton');\n    });\n  }\n\n  function lede() {\n    const el = document.getElementById('lede');\n    const c = dash.data('t1_candidatos'), c2 = dash.data('t2_candidatos'), p = dash.data('t2_uf_parcial');\n    if (c.status !== 'ok' || c2.status !== 'ok') return;\n    const g = (d, n) => d.data.find(x => +x.numero === n);\n    const terc = [70, 14, 55].reduce((s, n) => s + +g(c, n).pct_validos, 0);\n    el.textContent = '';\n    const add = (t, b) => { const s = document.createElement(b ? 'b' : 'span'); s.textContent = t; el.appendChild(s); };\n    add('Flávio Bolsonaro liderou o 1º turno com '); add(F.pct2(+g(c, 22).pct_validos), true);\n    add(' contra '); add(F.pct2(+g(c, 13).pct_validos), true); add(' de Lula, com a terceira via somando '); add(F.pct1(terc), true);\n    add('. No 2º turno, Lula venceu com '); add(F.pct2(+g(c2, 13).pct_validos), true); add(' dos válidos');\n    if (p.status === 'ok' && p.data.length) {\n      const up = p.data.filter(r => r.swing_pp > 0).length;\n      add(' e cresceu, nas mesmas urnas, em '); add(up + ' de ' + p.data.length, true); add(' UFs (incluindo o exterior).');\n    } else add('.');\n  }\n\n  // ---------- gráfico: candidatos\n  function chCand() {\n    const box = document.getElementById('ch-cand'), rows = ready('t1_candidatos', box); if (!rows) return;\n    box.innerHTML = '';\n    const W = box.clientWidth, bh = 22, H = rows.length * bh + 8;\n    const svg = d3.select(box).append('svg').attr('width', '100%').attr('viewBox', `0 0 ${W} ${H}`);\n    const left = measure(svg, rows.map(r => r.candidato)) + 10, right = measure(svg, ['00,00%']) + 8;\n    const x = d3.scaleLinear([0, d3.max(rows, r => +r.pct_validos)], [left, W - right]);\n    const t = tip(box);\n    const g = svg.selectAll('g').data(rows).join('g').attr('transform', (r, i) => `translate(0,${i * bh})`);\n    g.append('text').attr('class', 'lbl').attr('x', left - 8).attr('y', bh / 2).attr('dy', '.35em').attr('text-anchor', 'end').text(r => r.candidato);\n    g.append('rect').attr('x', left).attr('y', 4).attr('height', bh - 8).attr('rx', 4)\n      .attr('width', r => Math.max(1, x(+r.pct_validos) - left))\n      .attr('fill', r => +r.numero === 13 ? C13() : +r.numero === 22 ? C22() : [70, 14, 55].includes(+r.numero) ? dash.colors[2] : muted)\n      .on('mousemove', (ev, r) => t.show(ev, `${r.candidato} (${r.numero})`, [`${F.int(r.votos)} votos`, `${F.pct2(+r.pct_validos)} dos válidos`]))\n      .on('mouseleave', t.hide);\n    g.append('text').attr('x', r => x(+r.pct_validos) + 6).attr('y', bh / 2).attr('dy', '.35em').text(r => F.pct2(+r.pct_validos));\n  }\n\n  // ---------- gráfico: UF divergente\n  function chUF() {\n    const box = document.getElementById('ch-uf'), raw = ready('t1_uf', box); if (!raw) return;\n    box.innerHTML = '';\n    const rows = raw.slice().sort((a, b) => b.pct_13_no_par - a.pct_13_no_par);\n    const W = box.clientWidth, bh = 19, top = 20, H = rows.length * bh + top + 4;\n    const svg = d3.select(box).append('svg').attr('width', '100%').attr('viewBox', `0 0 ${W} ${H}`);\n    const lw = measure(svg, ['ZZ']) + 8, vw = measure(svg, ['00,0%']) + 6;\n    const ext = d3.max(rows, r => Math.abs(r.pct_13_no_par - .5));\n    const x = d3.scaleLinear([.5 - ext, .5 + ext], [lw + vw, W - vw]);\n    svg.append('line').attr('x1', x(.5)).attr('x2', x(.5)).attr('y1', top - 4).attr('y2', H).attr('stroke', 'var(--cds-chart-reference)');\n    svg.append('text').attr('x', x(.5) - 6).attr('y', 10).attr('text-anchor', 'end').text('← Flávio');\n    svg.append('text').attr('x', x(.5) + 6).attr('y', 10).text('Lula →');\n    const t = tip(box);\n    const g = svg.selectAll('g.r').data(rows).join('g').attr('class', 'r').attr('transform', (r, i) => `translate(0,${top + i * bh})`);\n    g.append('text').attr('class', 'lbl').attr('x', 0).attr('y', bh / 2).attr('dy', '.35em').text(r => r.uf);\n    g.append('rect').attr('y', 3).attr('height', bh - 6).attr('rx', 3)\n      .attr('x', r => Math.min(x(.5), x(r.pct_13_no_par))).attr('width', r => Math.max(1, Math.abs(x(r.pct_13_no_par) - x(.5))))\n      .attr('fill', r => r.pct_13_no_par >= .5 ? C13() : C22())\n      .on('mousemove', (ev, r) => t.show(ev, r.uf, [`Lula ${F.pct1(r.pct_13_no_par)} · Flávio ${F.pct1(1 - r.pct_13_no_par)} (no par)`, `${F.int(r.aptos)} aptos`]))\n      .on('mouseleave', t.hide);\n    g.append('text').attr('y', bh / 2).attr('dy', '.35em')\n      .attr('x', r => r.pct_13_no_par >= .5 ? x(r.pct_13_no_par) + 4 : x(r.pct_13_no_par) - 4)\n      .attr('text-anchor', r => r.pct_13_no_par >= .5 ? 'start' : 'end')\n      .text(r => F.pct1(r.pct_13_no_par >= .5 ? r.pct_13_no_par : 1 - r.pct_13_no_par));\n  }\n\n  // ---------- histograma\n  function chHist() {\n    const box = document.getElementById('ch-hist'), rows = ready('t1_hist_secao', box); if (!rows) return;\n    box.innerHTML = '';\n    const W = box.clientWidth, H = 240, m = {t: 8, r: 8, b: 26};\n    const svg = d3.select(box).append('svg').attr('width', '100%').attr('viewBox', `0 0 ${W} ${H}`);\n    const y = d3.scaleLinear([0, d3.max(rows, r => +r.secoes)], [H - m.b, m.t]).nice();\n    m.l = measure(svg, y.ticks(4).map(F.int)) + 10;\n    const x = d3.scaleLinear([0, 100], [m.l, W - m.r]);\n    svg.append('g').attr('transform', `translate(0,${H - m.b})`).call(d3.axisBottom(x).ticks(5).tickFormat(d => d + '%')).call(cleanAxis);\n    svg.append('g').attr('transform', `translate(${m.l},0)`).call(d3.axisLeft(y).ticks(4).tickFormat(F.int).tickSize(-(W - m.l - m.r))).call(cleanAxis).call(g => g.select('.domain').remove());\n    const t = tip(box);\n    svg.append('g').selectAll('rect').data(rows).join('rect')\n      .attr('x', r => x(+r.faixa_pct_13) + .5).attr('width', Math.max(1, x(2) - x(0) - 1))\n      .attr('y', r => y(+r.secoes)).attr('height', r => y(0) - y(+r.secoes)).attr('rx', 1)\n      .attr('fill', r => +r.faixa_pct_13 >= 50 ? C13() : C22())\n      .on('mousemove', (ev, r) => t.show(ev, `Lula entre ${r.faixa_pct_13}% e ${+r.faixa_pct_13 + 2}%`, [`${F.int(r.secoes)} seções`]))\n      .on('mouseleave', t.hide);\n  }\n\n  // ---------- abstenção x voto\n  function chAbst() {\n    const box = document.getElementById('ch-abst'), rows = ready('t1_abstencao_decil', box); if (!rows) return;\n    box.innerHTML = '';\n    const W = box.clientWidth, H = 240, m = {t: 10, r: 14, b: 28};\n    const svg = d3.select(box).append('svg').attr('width', '100%').attr('viewBox', `0 0 ${W} ${H}`);\n    const y = d3.scaleLinear(d3.extent(rows, r => +r.pct_13_no_par), [H - m.b, m.t]).nice();\n    m.l = measure(svg, y.ticks(4).map(F.pct1)) + 10;\n    const x = d3.scaleLinear(d3.extent(rows, r => +r.abstencao_media), [m.l, W - m.r]).nice();\n    svg.append('g').attr('transform', `translate(0,${H - m.b})`).call(d3.axisBottom(x).ticks(5).tickFormat(ptLocale.format('.0%'))).call(cleanAxis);\n    svg.append('g').attr('transform', `translate(${m.l},0)`).call(d3.axisLeft(y).ticks(4).tickFormat(F.pct1).tickSize(-(W - m.l - m.r))).call(cleanAxis).call(g => g.select('.domain').remove());\n    svg.append('path').datum(rows).attr('fill', 'none').attr('stroke', C13()).attr('stroke-width', 2).attr('stroke-linejoin', 'round').attr('stroke-linecap', 'round')\n      .attr('d', d3.line(r => x(+r.abstencao_media), r => y(+r.pct_13_no_par)));\n    const t = tip(box);\n    svg.selectAll('circle').data(rows).join('circle').attr('r', 4).attr('fill', C13())\n      .attr('cx', r => x(+r.abstencao_media)).attr('cy', r => y(+r.pct_13_no_par))\n      .on('mousemove', (ev, r) => t.show(ev, `${r.decil}º décimo de abstenção`, [`Abstenção média ${F.pct1(r.abstencao_media)}`, `Lula ${F.pct1(r.pct_13_no_par)} no par 13×22`]))\n      .on('mouseleave', t.hide);\n    svg.append('text').attr('x', W - m.r).attr('y', H - 2).attr('text-anchor', 'end').text('abstenção na seção');\n  }\n\n  // ---------- tabelas\n  function table(id, src, cols, filter) {\n    const el = document.getElementById(id), r = dash.data(src), tb = el.querySelector('tbody');\n    if (r.status !== 'ok') { if (r.status === 'error') { el.classList.remove('dash-skeleton'); tb.textContent = ''; } return; }\n    el.classList.remove('dash-skeleton'); tb.textContent = '';\n    (filter ? r.data.filter(filter) : r.data).forEach(row => {\n      const tr = document.createElement('tr');\n      cols.forEach(([f, fmt, cls]) => {\n        const td = document.createElement('td'); const v = row[f];\n        td.textContent = fmt ? fmt(+v) : v;\n        if (cls) { const c = cls(+v); if (c) td.className = c; }\n        tr.appendChild(td);\n      });\n      tb.appendChild(tr);\n    });\n  }\n  const sel = document.getElementById('sel-cand');\n  sel.addEventListener('change', () => tables());\n  function tables() {\n    table('tb-uf', 't1_uf', [['uf'], ['regiao'], ['aptos', F.int], ['abstencao_pct', F.pct1], ['pct_22', F.pct1], ['pct_13', F.pct1], ['pct_terceira_via', F.pct1], ['pct_13_no_par', F.pct1]]);\n    table('tb-urna', 't1_modelo_urna', [['modelo'], ['secoes', F.int], ['pct_13_bruto', F.pct2], ['desvio_mesmo_municipio_pp', v => pp(v) + ' p.p.']]);\n    const red = dash.data('t1_redutos');\n    if (red.status === 'ok' && !sel.options.length) {\n      [...new Set(red.data.map(r => r.candidato))].forEach(c => { const o = document.createElement('option'); o.value = o.textContent = c; sel.appendChild(o); });\n    }\n    table('tb-red', 't1_redutos', [['municipio'], ['aptos', F.int], ['pct_validos', F.pct1]], r => r.candidato === sel.value);\n    table('tb-t2', 't2_uf_parcial', [['uf'], ['secoes', F.int], ['pct_13_t1', F.pct1], ['pct_13_t2', F.pct1], ['swing_pp', pp, v => v > 0 ? 'el-pos' : v < 0 ? 'el-neg' : ''], ['abst_t1', F.pct1], ['abst_t2', F.pct1]]);\n  }\n\n  // ---------- dispersão T1 x T2\n  function chSc() {\n    const box = document.getElementById('ch-sc'), rows = ready('t2_dispersao', box); if (!rows) return;\n    box.innerHTML = '';\n    const ufs = [...new Set(rows.map(r => r.uf))].sort();\n    const col = d3.scaleOrdinal(ufs, dash.colors.slice(2));\n    const lg = document.getElementById('lg-sc'); lg.textContent = '';\n    ufs.forEach(u => { const s = document.createElement('span'), i = document.createElement('i'); i.style.background = col(u); s.append(i, u); lg.appendChild(s); });\n    const W = box.clientWidth, H = 300, m = {t: 8, r: 10, b: 28};\n    const svg = d3.select(box).append('svg').attr('width', '100%').attr('viewBox', `0 0 ${W} ${H}`);\n    m.l = measure(svg, ['100%']) + 10;\n    const x = d3.scaleLinear([0, 100], [m.l, W - m.r]), y = d3.scaleLinear([0, 100], [H - m.b, m.t]);\n    svg.append('g').attr('transform', `translate(0,${H - m.b})`).call(d3.axisBottom(x).ticks(5).tickFormat(d => d + '%')).call(cleanAxis);\n    svg.append('g').attr('transform', `translate(${m.l},0)`).call(d3.axisLeft(y).ticks(5).tickFormat(d => d + '%').tickSize(-(W - m.l - m.r))).call(cleanAxis).call(g => g.select('.domain').remove());\n    svg.append('line').attr('x1', x(0)).attr('y1', y(0)).attr('x2', x(100)).attr('y2', y(100)).attr('stroke', 'var(--cds-chart-reference)').attr('stroke-dasharray', '4 3');\n    const t = tip(box);\n    svg.append('g').selectAll('circle').data(rows).join('circle').attr('r', 2.2).attr('fill', r => col(r.uf)).attr('fill-opacity', .45)\n      .attr('cx', r => x(+r.pct_13_t1)).attr('cy', r => y(+r.pct_13_t2))\n      .on('mousemove', (ev, r) => t.show(ev, `Seção em ${r.uf}`, [`Lula 1º t.: ${ptLocale.format('.1f')(r.pct_13_t1)}%`, `Lula 2º t.: ${ptLocale.format('.1f')(r.pct_13_t2)}%`]))\n      .on('mouseleave', t.hide);\n  }\n\n  // ---------- matriz de transferência\n  function chTr() {\n    const box = document.getElementById('ch-tr'), rows = ready('t2_transferencia', box); if (!rows) return;\n    box.innerHTML = '';\n    const orig = [...new Set(rows.map(r => r.origem))], dest = [...new Set(rows.map(r => r.destino))];\n    const W = box.clientWidth, ch = 30, top = 24, H = orig.length * ch + top;\n    const svg = d3.select(box).append('svg').attr('width', '100%').attr('viewBox', `0 0 ${W} ${H}`);\n    const lw = measure(svg, orig) + 12;\n    const x = d3.scaleBand(dest, [lw, W]).padding(.06);\n    const destCol = {0: C13(), 1: C22()};\n    svg.selectAll('text.d').data(dest).join('text').attr('class', 'd lbl').attr('x', d => x(d) + x.bandwidth() / 2).attr('y', 14).attr('text-anchor', 'middle').text(d => d);\n    svg.selectAll('text.o').data(orig).join('text').attr('class', 'o lbl').attr('x', lw - 10).attr('y', (o, i) => top + i * ch + ch / 2).attr('dy', '.35em').attr('text-anchor', 'end').text(o => o);\n    const t = tip(box);\n    const g = svg.selectAll('g.c').data(rows).join('g').attr('class', 'c')\n      .attr('transform', r => `translate(${x(r.destino)},${top + orig.indexOf(r.origem) * ch})`);\n    g.append('rect').attr('width', x.bandwidth()).attr('height', ch - 4).attr('rx', 4)\n      .attr('fill', r => destCol[dest.indexOf(r.destino)] || 'var(--cds-chart-muted)')\n      .attr('fill-opacity', r => .06 + .9 * +r.pct)\n      .on('mousemove', (ev, r) => t.show(ev, `${r.origem} → ${r.destino}`, [F.pct1(+r.pct)]))\n      .on('mouseleave', t.hide);\n    g.append('text').attr('class', 'lbl').attr('x', x.bandwidth() / 2).attr('y', (ch - 4) / 2).attr('dy', '.35em').attr('text-anchor', 'middle')\n      .style('pointer-events', 'none').text(r => ptLocale.format('.0%')(+r.pct));\n  }\n\n  function prog() {\n    const r = dash.data('t2_progresso'); if (r.status !== 'ok' || !r.data.length) return;\n    const p = r.data[0], bar = document.getElementById('bar-prog'); if (bar) bar.style.width = (100 * p.secoes_coletadas / p.secoes_total).toFixed(1) + '%';\n  }\n\n  dash.onData(() => { fillMarks(); lede(); chCand(); chUF(); chHist(); chAbst(); tables(); chSc(); chTr(); prog(); });\n})();\n</script>\n"}